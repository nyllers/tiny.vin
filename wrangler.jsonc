{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiny-vin",
  "compatibility_date": "2026-07-25",
  "main": "src/index.js",
  "vars": {
    "SITE_URL": "https://tiny.vin"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tiny-vin-db",
      "database_id": "80934f84-32e3-480d-91b7-c1c2bd3d6144"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
